# Copier en .env et remplir. Aucune de ces valeurs n'est obligatoire pour la démo.

# Boîte aux lettres qui reçoit les alertes e-mail des sites d'annonces
# (idéalement une adresse dédiée ; pour Gmail, utiliser un « mot de passe d'application »).
NICHOIR_IMAP_HOST=imap.gmail.com
NICHOIR_IMAP_USER=
NICHOIR_IMAP_PASSWORD=
NICHOIR_IMAP_FOLDER=INBOX

# Flux RSS/Atom supplémentaires, séparés par des espaces.
NICHOIR_RSS_FEEDS=

# Optionnel : clé API Claude pour comprendre les recherches en langage naturel.
ANTHROPIC_API_KEY=

# Facteur appliqué aux temps de voiture OSRM (qui ignorent les bouchons). 1.3 ≈ heure de pointe.
NICHOIR_CAR_FACTOR=1.25

# Port du serveur web local.
NICHOIR_PORT=8000
